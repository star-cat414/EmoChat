# Copy this file to .env and fill in the real values. NEVER commit .env.
# EXPO_PUBLIC_* variables are inlined into the app bundle at build time.
# The anon key is public-safe — NEVER use the Supabase service_role key here.

# Supabase project URL (from your project settings)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (publishable) key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend URL. Use https://your-backend.onrender.com for the cloud backend,
# or http://localhost:8000 when running the backend locally (must match ALLOWED_ORIGIN).
EXPO_PUBLIC_API_URL=https://emochat-backend.onrender.com
